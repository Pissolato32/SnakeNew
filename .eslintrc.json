{
    "env": {
        "es2021": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:import/recommended"
    ],
    "settings": {
        "import/resolver": {
            "node": {
                "extensions": [
                    ".js"
                ]
            },
            "alias": {
                "map": [
                    ["/shared", "./src/shared"]
                ],
                "extensions": [".js"]
            }
        }
    },
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
        "no-console": "off",
        "indent": ["error", 4],
        "linebreak-style": ["error", "windows"],
        "quotes": ["error", "single"],
        "semi": ["error", "always"]
    },
    "overrides": [
        {
            "files": ["server.js", "*.js"],
            "excludedFiles": "public/**/*.js",
            "env": {
                "node": true,
                "jest/globals": true
            },
            "globals": {
                "GAME_TICK_RATE_MS": "readonly"
            },
            "plugins": [
                "jest"
            ]
        },
        {
            "files": ["public/**/*.js", "src/client/**/*.js"],
            "env": {
                "browser": true
            },
            "globals": {
                "io": "readonly",
                "SimplePeer": "readonly",
                "Chart": "readonly",
                "requestAnimationFrame": "readonly",
                "window": "readonly",
                "document": "readonly"
            }
        },
        {
            "files": ["__tests__/**/*.js"],
            "env": {
                "jest": true
            }
        }
    ]
}